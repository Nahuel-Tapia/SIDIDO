# Configuración de Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sidido

# Configuración del Servidor
PORT=4321
NODE_ENV=production

# Clave secreta para cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET=cambiar_por_clave_segura_de_al_menos_32_caracteres_hex

# Capa de Almacenamiento (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/pdfs

# Si STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=sidido-pdfs
# S3_REGION=us-east-1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# Tamaño máximo de PDF permitido en MB
MAX_UPLOAD_MB=50
