---
import AppLayout from '../../layouts/AppLayout.astro';
import { getDocumentById, getDocumentRevisions } from '../../server/services/documents';
import { canCreateOrEdit } from '../../server/auth/permissions';
import { logAudit } from '../../server/services/audit';

const user = Astro.locals.user!;
const role = user.role;
const id = Astro.params.id!;

const docData = await getDocumentById(id);

if (!docData) {
  return Astro.redirect('/consultas');
}

const revisions = await getDocumentRevisions(id);

// Auditar visualización de la ficha técnica
await logAudit({
  userId: user.id,
  action: 'doc.view',
  entityType: 'document',
  entityId: id,
  ipAddress: Astro.clientAddress,
  userAgent: Astro.request.headers.get('user-agent'),
});

const { doc, typeName, originCode, originName, creatorName } = docData;

function formatBytes(bytes: number | null) {
  if (!bytes) return 'N/A';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}
---

<AppLayout title={`${doc.number || 'Doc'} - Detalle del Documento`} activeNav="consultas">
  <div class="document-detail-page">
    <!-- Encabezado del Documento -->
    <div class="detail-header">
      <div class="header-left">
        <a href="/consultas" class="back-link">
          &larr; Volver a Consultas
        </a>
        <div class="doc-badge-row">
          <span class="badge badge-neutral">{typeName}</span>
          {originCode && <span class="badge badge-neutral">{originCode}</span>}
          <span class="doc-id-pill">N° {doc.number || 'S/N'} / {doc.year || '----'}</span>
          {doc.deletedAt && <span class="badge badge-failed">DADO DE BAJA</span>}
        </div>
        <h1 class="doc-headline">{doc.caratula || 'Sin carátula especificada'}</h1>
      </div>

      <div class="header-actions">
        {doc.fileKey && (
          <a
            href={`/api/documents/${doc.id}/file?download=1`}
            class="btn btn-primary"
            title="Descargar documento oficial"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Descargar PDF</span>
          </a>
        )}

        {canCreateOrEdit(role) && !doc.deletedAt && (
          <a href={`/documentos/${doc.id}/editar`} class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Editar</span>
          </a>
        )}
      </div>
    </div>

    <!-- Contenido en Dos Columnas: Ficha + Visor PDF -->
    <div class="detail-split">
      <!-- Columna Izquierda: Metadatos, Contenido OCR e Historial -->
      <div class="meta-column">
        <!-- Ficha Técnica -->
        <div class="card">
          <h2 class="section-title">Metadatos del Expediente</h2>
          <dl class="meta-dl">
            <div class="meta-item">
              <dt>Tipo de Documento</dt>
              <dd>{typeName}</dd>
            </div>
            <div class="meta-item">
              <dt>Origen / Repartición</dt>
              <dd>{originName ? `${originName} (${originCode})` : 'No especificado'}</dd>
            </div>
            <div class="meta-item">
              <dt>Número y Año</dt>
              <dd><strong>{doc.number || 'S/N'}</strong> del año <strong>{doc.year || '----'}</strong></dd>
            </div>
            <div class="meta-item">
              <dt>Fecha de Digitalización</dt>
              <dd>{new Date(doc.createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</dd>
            </div>
            <div class="meta-item">
              <dt>Digitalizado por</dt>
              <dd>{creatorName || 'Usuario del sistema'}</dd>
            </div>
            <div class="meta-item">
              <dt>Archivo PDF</dt>
              <dd>{doc.fileName || 'Documento adjunto'} ({formatBytes(doc.fileSize)})</dd>
            </div>
            <div class="meta-item">
              <dt>Estado de OCR</dt>
              <dd>
                {doc.ocrStatus === 'completed' && <span class="badge badge-completed">Indexado correctamente</span>}
                {doc.ocrStatus === 'processing' && <span class="badge badge-pending">Procesando OCR</span>}
                {doc.ocrStatus === 'pending' && <span class="badge badge-pending">En cola de OCR</span>}
                {doc.ocrStatus === 'failed' && <span class="badge badge-failed">Error en OCR</span>}
                {doc.ocrStatus === 'none' && <span class="badge badge-neutral">Sin archivo</span>}
              </dd>
            </div>
          </dl>

          {doc.extracto && (
            <div class="extracto-block">
              <h3 class="subsection-title">Extracto</h3>
              <p class="extracto-text">{doc.extracto}</p>
            </div>
          )}
        </div>

        <!-- Contenido Completo del Documento (OCR) -->
        <div class="card">
          <div class="content-header">
            <h2 class="section-title">Contenido del Documento (Indexado)</h2>
            <button type="button" id="copy-content-btn" class="btn btn-secondary btn-sm" title="Copiar texto al portapapeles">
              Copiar Texto
            </button>
          </div>
          
          <div class="content-body" id="doc-content-text">
            {doc.contenido ? (
              <pre class="content-pre">{doc.contenido}</pre>
            ) : (
              <p class="content-empty">
                {doc.fileKey
                  ? 'El contenido está siendo procesado por el motor de OCR. Actualice en unos instantes.'
                  : 'Este documento no posee contenido textual ni archivo PDF adjunto.'}
              </p>
            )}
          </div>
        </div>

        <!-- Historial de Revisiones y Auditoría del Documento -->
        <div class="card">
          <h2 class="section-title">Historial de Revisiones</h2>
          <div class="revisions-list">
            {revisions.map((r) => (
              <div class="revision-entry">
                <div class="revision-bullet"></div>
                <div class="revision-details">
                  <div class="revision-title">
                    <span class="revision-action">
                      {r.rev.action === 'create' && 'Creación del documento'}
                      {r.rev.action === 'update' && 'Modificación de datos'}
                      {r.rev.action === 'delete' && 'Baja lógica'}
                      {r.rev.action === 'restore' && 'Restauración'}
                      {r.rev.action === 'ocr_update' && 'Indexación por OCR'}
                    </span>
                    <span class="revision-date">
                      {new Date(r.rev.changedAt).toLocaleString('es-AR')}
                    </span>
                  </div>
                  <span class="revision-author">{r.userName || 'Sistema'}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Visor de PDF Embebido -->
      <div class="viewer-column">
        <div class="card viewer-card">
          <div class="viewer-header">
            <div class="viewer-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Visor Oficial del Documento</span>
            </div>
            
            {doc.fileKey && (
              <a
                href={`/api/documents/${doc.id}/file?download=1`}
                class="btn btn-secondary btn-sm"
                target="_blank"
                rel="noopener"
              >
                Abrir en nueva pestaña
              </a>
            )}
          </div>

          <div class="viewer-viewport">
            {doc.fileKey ? (
              <iframe
                src={`/api/documents/${doc.id}/file`}
                class="pdf-frame"
                title={`Visor del documento ${doc.number}`}
              ></iframe>
            ) : (
              <div class="no-file-state">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
                <p>Este documento no tiene un archivo PDF adjunto.</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  const copyBtn = document.getElementById('copy-content-btn');
  const contentText = document.getElementById('doc-content-text');

  if (copyBtn && contentText) {
    copyBtn.addEventListener('click', () => {
      const text = contentText.innerText;
      navigator.clipboard.writeText(text).then(() => {
        const orig = copyBtn.innerText;
        copyBtn.innerText = '¡Copiado!';
        setTimeout(() => {
          copyBtn.innerText = orig;
        }, 2000);
      });
    });
  }
</script>

<style>
  .document-detail-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    background-color: var(--bg-surface);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .back-link:hover {
    color: var(--sj-charcoal);
  }

  .doc-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .doc-id-pill {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--sj-charcoal);
  }

  .doc-headline {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--sj-charcoal);
    line-height: 1.3;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .detail-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .meta-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--sj-charcoal);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .meta-dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem 1rem;
    font-size: 0.875rem;
  }

  .meta-item dt {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .meta-item dd {
    font-size: 0.875rem;
    color: var(--sj-charcoal);
    margin-top: 0.125rem;
  }

  .extracto-block {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  .subsection-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sj-charcoal);
    margin-bottom: 0.375rem;
  }

  .extracto-text {
    font-size: 0.875rem;
    color: #374151;
    line-height: 1.5;
  }

  .content-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .content-body {
    max-height: 380px;
    overflow-y: auto;
    background-color: #FAFBFB;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .content-pre {
    font-family: inherit;
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    color: #374151;
  }

  .content-empty {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .revisions-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .revision-entry {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .revision-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--sj-red);
    margin-top: 0.375rem;
    flex-shrink: 0;
  }

  .revision-details {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .revision-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .revision-action {
    font-weight: 600;
    color: var(--sj-charcoal);
  }

  .revision-date {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .revision-author {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .viewer-column {
    position: sticky;
    top: 5rem;
  }

  .viewer-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 120px);
    min-height: 600px;
  }

  .viewer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-light);
    background-color: #FAFBFB;
  }

  .viewer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sj-charcoal);
  }

  .viewer-viewport {
    flex: 1;
    background-color: #525659;
  }

  .pdf-frame {
    width: 100%;
    height: 100%;
    border: none;
  }

  .no-file-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #9CA3AF;
    gap: 0.75rem;
    background-color: #F9FAFB;
  }

  @media (max-width: 1024px) {
    .detail-split {
      grid-template-columns: 1fr;
    }
    .viewer-column {
      position: static;
    }
  }
</style>
