---
import AppLayout from '../../layouts/AppLayout.astro';
import { getDocumentById, getDocumentRevisions } from '../../server/services/documents';
import { canCreateOrEdit } from '../../server/auth/permissions';
import { logAudit } from '../../server/services/audit';

const user = Astro.locals.user!;
const role = user.role;
const id = Astro.params.id!;

const docData = await getDocumentById(id);

if (!docData) {
  return Astro.redirect('/consultas');
}

const revisions = await getDocumentRevisions(id);

// Auditar visualización de la ficha técnica
await logAudit({
  userId: user.id,
  action: 'doc.view',
  entityType: 'document',
  entityId: id,
  ipAddress: Astro.clientAddress,
  userAgent: Astro.request.headers.get('user-agent'),
});

const { doc, typeName, originCode, originName, creatorName } = docData;

function formatBytes(bytes: number | null) {
  if (!bytes) return 'N/A';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}
---

<AppLayout title={`${doc.number || 'Doc'} - Detalle del Documento`} activeNav="consultas">
  <div class="document-detail-page">
    <!-- Encabezado del Documento -->
    <div class="detail-header">
      <div class="header-left">
        <a href="/consultas" class="back-link">
          &larr; Volver al listado de Consultas
        </a>
        <div class="doc-badge-row">
          <span class="badge badge-neutral">{typeName}</span>
          {originCode && <span class="badge badge-neutral">{originCode}</span>}
          <span class="doc-number-pill">
            N° <strong>{doc.number || 'S/N'}</strong> / {doc.year || '----'}
          </span>
          {doc.expediente && (
            <span class="badge" style="background: #FFF4E5; color: #1D252D; border: 1px solid #FFD8A8; font-weight: 600; font-family: var(--font-mono);">
              Expte: {doc.expediente}
            </span>
          )}
          {doc.ocrStatus === 'completed' && (
            <span class="badge badge-completed">
              <span class="badge-dot"></span>
              OCR Indexado
            </span>
          )}
          {doc.deletedAt && <span class="badge badge-failed">DADO DE BAJA</span>}
        </div>
        <h1 class="doc-headline">{doc.caratula || 'Sin carátula especificada'}</h1>
      </div>

      <div class="header-actions">
        {doc.fileKey && (
          <a
            href={`/api/documents/${doc.id}/file?download=1`}
            class="btn btn-primary"
            title="Descargar documento oficial en PDF"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Descargar PDF</span>
          </a>
        )}

        {canCreateOrEdit(role) && !doc.deletedAt && (
          <a href={`/documentos/${doc.id}/editar`} class="btn btn-secondary">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Editar</span>
          </a>
        )}
      </div>
    </div>

    <!-- Contenido en Dos Columnas: Panel por Pestañas + Visor PDF -->
    <div id="detail-split-layout" class="detail-split">
      <!-- Columna Izquierda: Pestañas Limpias sin scroll excesivo -->
      <div class="meta-column card">
        <div class="detail-tabs" role="tablist" aria-label="Información del documento">
          <button
            type="button"
            class="tab-btn active"
            data-tab="ficha"
            role="tab"
            aria-selected="true"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>Ficha y Extracto</span>
          </button>

          <button
            type="button"
            class="tab-btn"
            data-tab="ocr"
            role="tab"
            aria-selected="false"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 7 4 4 20 4 20 7"></polyline>
              <line x1="9" y1="20" x2="15" y2="20"></line>
              <line x1="12" y1="4" x2="12" y2="20"></line>
            </svg>
            <span>Texto OCR</span>
          </button>

          <button
            type="button"
            class="tab-btn"
            data-tab="historial"
            role="tab"
            aria-selected="false"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>Historial ({revisions.length})</span>
          </button>
        </div>

        <!-- PANEL 1: Ficha Técnica y Extracto -->
        <div id="tab-panel-ficha" class="tab-panel">
          {doc.extracto && (
            <div class="extracto-highlight-box">
              <h3 class="subsection-title">Síntesis / Extracto Oficial</h3>
              <p class="extracto-text">{doc.extracto}</p>
            </div>
          )}

          {doc.extractedMetadata && (
            (doc.extractedMetadata.expediente ||
              doc.extractedMetadata.dnis?.length ||
              doc.extractedMetadata.cuils?.length ||
              doc.extractedMetadata.people?.length ||
              doc.extractedMetadata.institutions?.length ||
              doc.extractedMetadata.detectedDate) ? (
              <div class="extracted-entities-panel">
                <h2 class="section-subtitle">Datos Detectados Automáticamente en el PDF</h2>
                <div class="entities-grid">
                  {doc.extractedMetadata.expediente && (
                    <div class="entity-group">
                      <span class="entity-group-label">N° de Expediente Detectado</span>
                      <div class="entity-chips">
                        <a href={`/consultas?expediente=${encodeURIComponent(doc.extractedMetadata.expediente)}`} class="entity-badge" style="background: #FFF4E5; color: #8F2018; border-color: #FFD8A8; font-family: var(--font-mono); font-weight: 700;" title="Ver documentos de este expediente">
                          {doc.extractedMetadata.expediente}
                        </a>
                      </div>
                    </div>
                  )}

                  {doc.extractedMetadata.dnis && doc.extractedMetadata.dnis.length > 0 && (
                    <div class="entity-group">
                      <span class="entity-group-label">DNI(s) Asociados</span>
                      <div class="entity-chips">
                        {doc.extractedMetadata.dnis.map((d) => (
                          <a href={`/consultas?dni=${encodeURIComponent(d)}`} class="entity-badge entity-badge-dni" title="Ver todos los expedientes de este DNI">
                            DNI {d}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  {doc.extractedMetadata.cuils && doc.extractedMetadata.cuils.length > 0 && (
                    <div class="entity-group">
                      <span class="entity-group-label">CUIL / CUIT</span>
                      <div class="entity-chips">
                        {doc.extractedMetadata.cuils.map((c) => (
                          <a href={`/consultas?dni=${encodeURIComponent(c)}`} class="entity-badge entity-badge-cuil">
                            {c}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  {doc.extractedMetadata.people && doc.extractedMetadata.people.length > 0 && (
                    <div class="entity-group entity-group-full">
                      <span class="entity-group-label">Nombres Asociados (Personas / Docentes / Agentes)</span>
                      <div class="entity-chips">
                        {doc.extractedMetadata.people.map((p) => (
                          <a href={`/consultas?persona=${encodeURIComponent(p)}`} class="entity-badge entity-badge-person" title="Buscar documentos asociados a esta persona">
                            {p}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  {doc.extractedMetadata.institutions && doc.extractedMetadata.institutions.length > 0 && (
                    <div class="entity-group entity-group-full">
                      <span class="entity-group-label">Instituciones / Escuelas</span>
                      <div class="entity-chips">
                        {doc.extractedMetadata.institutions.map((inst) => (
                          <a href={`/consultas?q=${encodeURIComponent(inst)}`} class="entity-badge entity-badge-inst">
                            {inst}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  {doc.extractedMetadata.detectedDate && (
                    <div class="entity-group">
                      <span class="entity-group-label">Fecha en el Documento</span>
                      <span class="entity-date-val">{doc.extractedMetadata.detectedDate}</span>
                    </div>
                  )}
                </div>
              </div>
            ) : null
          )}

          <h2 class="section-subtitle">Datos Registrales</h2>
          <dl class="meta-dl">
            <div class="meta-item">
              <dt>Tipo de Documento</dt>
              <dd>{typeName}</dd>
            </div>
            <div class="meta-item">
              <dt>Origen / Repartición</dt>
              <dd>{originName ? `${originName} (${originCode})` : 'No especificado'}</dd>
            </div>
            <div class="meta-item">
              <dt>N° de Expediente</dt>
              <dd>
                {doc.expediente ? (
                  <a
                    href={`/consultas?expediente=${encodeURIComponent(doc.expediente)}`}
                    style="font-family: var(--font-mono); font-weight: 600; color: #E03C31; text-decoration: none;"
                    title="Filtrar por este expediente"
                  >
                    {doc.expediente}
                  </a>
                ) : (
                  <span style="color: var(--color-text-muted);">No especificado</span>
                )}
              </dd>
            </div>
            <div class="meta-item">
              <dt>Número y Año</dt>
              <dd><strong>{doc.number || 'S/N'}</strong> / <strong>{doc.year || '----'}</strong></dd>
            </div>
            <div class="meta-item">
              <dt>Fecha de Digitalización</dt>
              <dd>{new Date(doc.createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</dd>
            </div>
            <div class="meta-item">
              <dt>Digitalizado por</dt>
              <dd>{creatorName || 'Usuario del sistema'}</dd>
            </div>
            <div class="meta-item">
              <dt>Archivo Adjunto</dt>
              <dd>{doc.fileName || 'Sin archivo'} ({formatBytes(doc.fileSize)})</dd>
            </div>
          </dl>
        </div>

        <!-- PANEL 2: Contenido Completo del Documento (OCR) con Buscador Interno -->
        <div id="tab-panel-ocr" class="tab-panel" style="display: none;">
          <div class="ocr-toolbar">
            <div class="ocr-search-wrapper">
              <input
                type="search"
                id="ocr-filter-input"
                class="form-input ocr-search-input"
                placeholder="Buscar y resaltar palabra dentro del texto..."
              />
            </div>
            <button type="button" id="copy-content-btn" class="btn btn-secondary btn-sm" title="Copiar texto al portapapeles">
              Copiar Texto
            </button>
          </div>
          
          <div class="content-body" id="doc-content-text">
            {doc.contenido ? (
              <pre id="ocr-pre-content" class="content-pre" data-raw={doc.contenido}>{doc.contenido}</pre>
            ) : (
              <p class="content-empty">
                {doc.fileKey
                  ? 'El contenido está siendo procesado por el motor de OCR. Actualice en unos instantes.'
                  : 'Este documento no posee contenido textual ni archivo PDF adjunto.'}
              </p>
            )}
          </div>
        </div>

        <!-- PANEL 3: Historial de Revisiones -->
        <div id="tab-panel-historial" class="tab-panel" style="display: none;">
          <div class="revisions-list">
            {revisions.map((r) => (
              <div class="revision-entry">
                <div class="revision-bullet"></div>
                <div class="revision-details">
                  <div class="revision-title">
                    <span class="revision-action">
                      {r.rev.action === 'create' && 'Creación del documento'}
                      {r.rev.action === 'update' && 'Modificación de datos'}
                      {r.rev.action === 'delete' && 'Baja lógica'}
                      {r.rev.action === 'restore' && 'Restauración'}
                      {r.rev.action === 'ocr_update' && 'Indexación automática por OCR'}
                    </span>
                    <span class="revision-date">
                      {new Date(r.rev.changedAt).toLocaleString('es-AR')}
                    </span>
                  </div>
                  <span class="revision-author">Operador: {r.userName || 'Sistema'} • Versión #{r.rev.version}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Visor de PDF Embebido -->
      <div class="viewer-column">
        <div class="card viewer-card">
          <div class="viewer-header">
            <div class="viewer-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sj-red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Visor Oficial del Documento</span>
            </div>
            
            <div class="viewer-controls">
              <button
                type="button"
                id="expand-viewer-btn"
                class="btn btn-secondary btn-sm"
                title="Ampliar o restaurar el ancho del visor PDF"
              >
                Ampliar Visor
              </button>
              {doc.fileKey && (
                <a
                  href={`/api/documents/${doc.id}/file`}
                  class="btn btn-secondary btn-sm"
                  target="_blank"
                  rel="noopener"
                >
                  Nueva pestaña &#8599;
                </a>
              )}
            </div>
          </div>

          <div class="viewer-viewport">
            {doc.fileKey ? (
              <iframe
                src={`/api/documents/${doc.id}/file`}
                class="pdf-frame"
                title={`Visor del documento ${doc.number}`}
              ></iframe>
            ) : (
              <div class="no-file-state">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
                <p>Este documento no tiene un archivo PDF adjunto.</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  // Pestañas de la columna izquierda
  const tabBtns = document.querySelectorAll('.tab-btn');
  const panels: Record<string, HTMLElement | null> = {
    ficha: document.getElementById('tab-panel-ficha'),
    ocr: document.getElementById('tab-panel-ocr'),
    historial: document.getElementById('tab-panel-historial'),
  };

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.tab || 'ficha';
      tabBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      Object.entries(panels).forEach(([key, panel]) => {
        if (panel) {
          panel.style.display = key === target ? 'flex' : 'none';
        }
      });
    });
  });

  // Buscador interno en el texto OCR
  const ocrInput = document.getElementById('ocr-filter-input') as HTMLInputElement;
  const ocrPre = document.getElementById('ocr-pre-content') as HTMLElement;

  function escapeHtml(str: string) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  ocrInput?.addEventListener('input', () => {
    if (!ocrPre) return;
    const raw = ocrPre.dataset.raw || '';
    const term = ocrInput.value.trim();
    if (!term) {
      ocrPre.textContent = raw;
      return;
    }
    const escapedTerm = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${escapedTerm})`, 'gi');
    ocrPre.innerHTML = escapeHtml(raw).replace(regex, '<mark>$1</mark>');
  });

  // Copiar texto OCR
  const copyBtn = document.getElementById('copy-content-btn');
  if (copyBtn && ocrPre) {
    copyBtn.addEventListener('click', () => {
      const text = ocrPre.dataset.raw || ocrPre.innerText;
      navigator.clipboard.writeText(text).then(() => {
        const orig = copyBtn.innerText;
        copyBtn.innerText = '✓ ¡Copiado!';
        setTimeout(() => {
          copyBtn.innerText = orig;
        }, 2000);
      });
    });
  }

  // Ampliar / Restaurar ancho del visor PDF
  const expandBtn = document.getElementById('expand-viewer-btn');
  const splitLayout = document.getElementById('detail-split-layout');
  expandBtn?.addEventListener('click', () => {
    if (!splitLayout) return;
    const isExpanded = splitLayout.classList.toggle('viewer-expanded');
    expandBtn.textContent = isExpanded ? 'Restaurar Vista Dividida' : 'Ampliar Visor';
  });
</script>

<style>
  .document-detail-page {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    background-color: var(--bg-surface);
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
  }

  .back-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .back-link:hover {
    color: var(--sj-red);
  }

  .doc-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
    flex-wrap: wrap;
  }

  .doc-headline {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--sj-charcoal);
    line-height: 1.3;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .detail-split {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 1.35rem;
    align-items: start;
    transition: all var(--transition-fast);
  }

  .detail-split.viewer-expanded {
    grid-template-columns: 1fr;
  }

  .meta-column {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1.15rem 1.25rem;
  }

  .detail-tabs {
    display: flex;
    gap: 0.35rem;
    background-color: var(--bg-alt);
    padding: 0.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
  }

  .tab-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--sj-charcoal);
  }

  .tab-btn.active {
    background-color: var(--bg-surface);
    color: var(--sj-red);
    box-shadow: var(--shadow-xs);
  }

  .tab-panel {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .extracto-highlight-box {
    background-color: #F8FAFC;
    border-left: 3px solid var(--sj-red);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.85rem 1rem;
  }

  .subsection-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-bottom: 0.3rem;
  }

  .extracto-text {
    font-size: 0.875rem;
    color: var(--sj-charcoal);
    line-height: 1.55;
  }

  .section-subtitle {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sj-charcoal);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 0.45rem;
  }

  .extracted-entities-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: #F8FAFC;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
  }

  .entities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1rem;
  }

  .entity-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .entity-group-full {
    grid-column: 1 / -1;
  }

  .entity-group-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .entity-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .entity-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .entity-badge-dni {
    background-color: var(--sj-red-subtle);
    color: var(--sj-red);
    border: 1px solid var(--sj-red-border);
  }
  .entity-badge-dni:hover {
    background-color: var(--sj-red);
    color: white;
  }

  .entity-badge-cuil {
    background-color: var(--sj-orange-subtle);
    color: #9A3412;
    border: 1px solid var(--sj-orange-border);
  }

  .entity-badge-person {
    background-color: #EFF6FF;
    color: #1E40AF;
    border: 1px solid #BFDBFE;
  }
  .entity-badge-person:hover {
    background-color: #1E40AF;
    color: white;
  }

  .entity-badge-inst {
    background-color: #F0FDF4;
    color: #065F46;
    border: 1px solid #A7F3D0;
  }

  .entity-date-val {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sj-charcoal);
  }

