---
import AppLayout from '../../layouts/AppLayout.astro';
import { getDocumentTypes, getOrigins } from '../../server/services/catalog';

const types = await getDocumentTypes(true);
const originsList = await getOrigins(true);
const currentYear = new Date().getFullYear();
---

<AppLayout title="Anexar Documento" activeNav="anexar">
  <div class="anexar-page">
    <div class="page-header">
      <div>
        <h1 class="page-title">Anexar Nuevo Documento</h1>
        <p class="page-desc">
          Arrastre el PDF para previsualizarlo y autocompletar datos, o complete la ficha técnica manualmente.
        </p>
      </div>
      <a href="/consultas" class="btn btn-secondary">
        &larr; Volver a Consultas
      </a>
    </div>

    <form id="anexar-form" class="anexar-grid">
      <!-- Columna Izquierda: Metadatos del Documento -->
      <div class="card meta-card">
        <div class="section-header-row">
          <div class="step-badge">1</div>
          <div>
            <h2 class="card-section-title">Datos del Expediente / Documento</h2>
            <p class="card-section-sub">Identificación oficial para búsqueda rápida</p>
          </div>
        </div>

        <!-- Banner de Autocompletado Inteligente desde el PDF -->
        <div id="autofill-banner" class="alert-autofill" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span id="autofill-banner-text">Se detectaron y completaron datos automáticamente leyendo el contenido del PDF.</span>
        </div>

        <!-- Alerta en Vivo de Duplicado -->
        <div id="duplicate-warning" class="alert-warning" style="display: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>Atención: Ya existe un documento activo con este Tipo, Origen, Número y Año.</span>
        </div>

        <div class="form-row-2">
          <!-- Tipo de Documento (Obligatorio) -->
          <div class="form-group">
            <label for="typeId" class="form-label">Tipo de Documento <span class="required">*</span></label>
            <select id="typeId" name="typeId" class="form-select" required>
              <option value="">Seleccione un tipo...</option>
              {types.map((t) => (
                <option value={t.id} data-code={t.code} data-name={t.name}>
                  {t.name} ({t.code})
                </option>
              ))}
            </select>
          </div>

          <!-- Origen -->
          <div class="form-group">
            <label for="originId" class="form-label">Origen (Repartición)</label>
            <select id="originId" name="originId" class="form-select">
              <option value="">Sin origen específico</option>
              {originsList.map((o) => (
                <option value={o.id} data-code={o.code} data-name={o.name}>
                  {o.name} ({o.code})
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="form-row-3">
          <!-- Número -->
          <div class="form-group">
            <label for="number" class="form-label">Número</label>
            <input
              type="text"
              id="number"
              name="number"
              class="form-input"
              placeholder="Ej: 1420 o 4820-A"
            />
          </div>

          <!-- Año -->
          <div class="form-group">
            <label for="year" class="form-label">Año</label>
            <input
              type="number"
              id="year"
              name="year"
              class="form-input"
              value={currentYear}
              min="1900"
              max={currentYear + 1}
            />
          </div>

          <!-- Número de Expediente (Auto-completado con formato ej: 300-028554-2026) -->
          <div class="form-group">
            <label for="expediente" class="form-label">
              N° Expediente <span class="badge-auto-tag">Auto</span>
            </label>
            <input
              type="text"
              id="expediente"
              name="expediente"
              class="form-input form-input-expte"
              placeholder="Ej: 300-028554-2026"
            />
          </div>
        </div>

        <!-- Carátula -->
        <div class="form-group">
          <label for="caratula" class="form-label">Carátula / Título Principal</label>
          <input
            type="text"
            id="caratula"
            name="caratula"
            class="form-input"
            placeholder="Título, causa o motivo principal del expediente..."
          />
        </div>

        <!-- Extracto -->
        <div class="form-group">
          <label for="extracto" class="form-label">Extracto / Síntesis</label>
          <textarea
            id="extracto"
            name="extracto"
            rows="3"
            class="form-textarea"
            placeholder="Resumen del contenido, partes intervinientes o resolución adoptada..."
          ></textarea>
        </div>

        <!-- Panel de Datos y Entidades Detectadas Automáticamente (DNI, Nombres Asociados, Escuelas, Fecha) -->
        <div class="detected-entities-box">
          <div class="detected-entities-header">
            <div class="detected-header-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sj-red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <polyline points="17 11 19 13 23 9"></polyline>
              </svg>
              <span>Datos Detectados en el PDF (DNIs, Nombres Asociados e Instituciones)</span>
            </div>
            <span id="detected-badge-status" class="badge badge-neutral">Automático al subir PDF</span>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="detected-dnis" class="form-label">
                DNI(s) Detectados <span class="label-hint">(separados por coma)</span>
              </label>
              <input
                type="text"
                id="detected-dnis"
                class="form-input"
                placeholder="Ej: 28.456.789, 31.450.992"
              />
            </div>

            <div class="form-group">
              <label for="detected-cuils" class="form-label">
                CUIL(s) / Fecha Detectada
              </label>
              <input
                type="text"
                id="detected-cuils"
                class="form-input"
                placeholder="Ej: 27-28456789-4"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="detected-people" class="form-label">
              Nombres Asociados (Personas / Agentes / Docentes) <span class="label-hint">(separados por punto y coma ";")</span>
            </label>
            <input
              type="text"
              id="detected-people"
              class="form-input"
              placeholder="Ej: María Elena Quiroga; Carlos Alberto Sarmiento"
            />
          </div>

          <div class="form-group">
            <label for="detected-institutions" class="form-label">
              Escuelas / Instituciones Detectadas <span class="label-hint">(separadas por ";")</span>
            </label>
            <input
              type="text"
              id="detected-institutions"
              class="form-input"
              placeholder="Ej: Escuela Agrotécnica Cornelio Saavedra"
            />
          </div>
          <input type="hidden" id="detected-date" value="" />
        </div>

        <!-- Contenido Manual (Colapsable / Opcional) -->
        <details class="manual-content-details">
          <summary class="manual-content-summary">
            <span>Texto Extraído del PDF / Transcripción (Editable)</span>
            <span class="label-hint">Se completa automáticamente al analizar el PDF</span>
          </summary>
          <div class="form-group" style="margin-top: 0.75rem;">
            <textarea
              id="contenido"
              name="contenido"
              rows="4"
              class="form-textarea"
              placeholder="Texto completo del documento o notas adicionales del operador..."
            ></textarea>
          </div>
        </details>
      </div>

      <!-- Columna Derecha: Carga y Previsualización en Vivo del PDF -->
      <div class="card file-card">
        <div class="section-header-row">
          <div class="step-badge">2</div>
          <div>
            <h2 class="card-section-title">Archivo Digitalizado (PDF)</h2>
            <p class="card-section-sub">Subida directa con vista previa e indexación OCR en español</p>
          </div>
        </div>

        <!-- Zona Drag & Drop -->
        <div id="dropzone" class="dropzone" role="button" tabindex="0">
          <input type="file" id="pdf-file-input" accept="application/pdf" style="display: none;" />
          
          <div class="dropzone-content">
            <div class="dropzone-icon-circle">
              <svg class="dropzone-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="12" x2="12" y2="18"></line>
                <polyline points="9 15 12 12 15 15"></polyline>
              </svg>
            </div>
            <p class="dropzone-text">
              <strong>Arrastre el archivo PDF aquí</strong> o haga clic para examinar
            </p>
            <span class="dropzone-hint">Formato PDF escaneado o digital (máx. 50 MB) • Autocompleta datos si el nombre incluye Tipo y Número</span>
          </div>
        </div>

        <!-- Estado de Archivo + Visor de Previsualización en Vivo -->
        <div id="file-status" class="file-status-box" style="display: none;">
          <div class="file-info-header">
            <div class="file-title-group">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sj-red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span id="file-name-display" class="file-name">archivo.pdf</span>
            </div>
            <button type="button" id="remove-file-btn" class="btn btn-secondary btn-sm" title="Cambiar o quitar archivo">
              Cambiar PDF
            </button>
          </div>
          
          <div class="progress-bar-container">
            <div id="progress-bar-fill" class="progress-bar-fill" style="width: 0%;"></div>
          </div>
          
          <div class="progress-meta">
            <span id="progress-percent">Subiendo... 0%</span>
            <span id="file-size-display">0 KB</span>
          </div>

          <!-- Previsualización instantánea del PDF para leer mientras se carga -->
          <div class="live-preview-wrapper">
            <div class="live-preview-bar">
              <span>Vista previa del documento seleccionado</span>
            </div>
            <iframe id="local-pdf-preview" class="local-pdf-frame" title="Vista previa del PDF seleccionado"></iframe>
          </div>
        </div>

        <!-- Resumen de OCR Automático -->
        <div class="ocr-notice-box">
          <div class="notice-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <p class="notice-text">
            Al guardar, el motor híbrido extraerá el texto digital o ejecutará <strong>OCR en español</strong> en segundo plano sin demorar su carga.
          </p>
        </div>

        <div id="form-error" class="alert-error" style="display: none;"></div>

        <!-- Botones de Acción -->
        <div class="form-actions">
          <button type="submit" id="btn-save" class="btn btn-primary btn-save">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span class="btn-text">Guardar y Anexar Documento</span>
          </button>
        </div>
      </div>
    </form>
  </div>
</AppLayout>

<script>
  let uploadedFileData: any = null;
  let previewObjectUrl: string | null = null;

  const dropzone = document.getElementById('dropzone') as HTMLElement;
  const fileInput = document.getElementById('pdf-file-input') as HTMLInputElement;
  const fileStatus = document.getElementById('file-status') as HTMLElement;
  const fileNameDisplay = document.getElementById('file-name-display') as HTMLElement;
  const fileSizeDisplay = document.getElementById('file-size-display') as HTMLElement;
  const progressBarFill = document.getElementById('progress-bar-fill') as HTMLElement;
  const progressPercent = document.getElementById('progress-percent') as HTMLElement;
  const removeFileBtn = document.getElementById('remove-file-btn') as HTMLElement;
  const localPdfPreview = document.getElementById('local-pdf-preview') as HTMLIFrameElement;
  const autofillBanner = document.getElementById('autofill-banner') as HTMLElement;
  const form = document.getElementById('anexar-form') as HTMLFormElement;
  const duplicateWarning = document.getElementById('duplicate-warning') as HTMLElement;
  const formError = document.getElementById('form-error') as HTMLElement;
  const btnSave = document.getElementById('btn-save') as HTMLButtonElement;

  const typeSelect = document.getElementById('typeId') as HTMLSelectElement;
  const originSelect = document.getElementById('originId') as HTMLSelectElement;
  const numberInput = document.getElementById('number') as HTMLInputElement;
  const yearInput = document.getElementById('year') as HTMLInputElement;
  const expedienteInput = document.getElementById('expediente') as HTMLInputElement;
  const caratulaInput = document.getElementById('caratula') as HTMLInputElement;
  const extractoInput = document.getElementById('extracto') as HTMLTextAreaElement;
  const contenidoInput = document.getElementById('contenido') as HTMLTextAreaElement;

  const detectedDnisInput = document.getElementById('detected-dnis') as HTMLInputElement;
  const detectedCuilsInput = document.getElementById('detected-cuils') as HTMLInputElement;
  const detectedPeopleInput = document.getElementById('detected-people') as HTMLInputElement;
  const detectedInstitutionsInput = document.getElementById('detected-institutions') as HTMLInputElement;
  const detectedDateInput = document.getElementById('detected-date') as HTMLInputElement;
  const detectedBadgeStatus = document.getElementById('detected-badge-status') as HTMLElement;
  const autofillBannerText = document.getElementById('autofill-banner-text') as HTMLElement;

  // Manejo de Dropzone
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') fileInput.click();
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropzone.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropzone.classList.add('drag-active');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropzone.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-active');
    });
  });

  dropzone.addEventListener('drop', (e) => {
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleFileSelected(e.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleFileSelected(fileInput.files[0]);
    }
  });

  function formatBytes(bytes: number) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function normalizeStr(s: string) {
    return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  }

  // Autocompletado preliminar instantáneo a partir del nombre del archivo PDF
  function smartAutofillFromFilename(filename: string) {
    const base = filename.replace(/\.pdf$/i, '');
    const norm = normalizeStr(base);
    let suggestedAny = false;

    if (!typeSelect.value) {
      for (const opt of Array.from(typeSelect.options)) {
        if (!opt.value) continue;
        const code = normalizeStr(opt.dataset.code || '');
        const name = normalizeStr(opt.dataset.name || '').split(' ')[0];
        if (
          (name && norm.includes(name)) ||
          (code && new RegExp(`(^|[_\\-\\s])${code}([_\\-\\s]|$)`).test(norm))
        ) {
          typeSelect.value = opt.value;
          suggestedAny = true;
          break;
        }
      }
    }

    if (!originSelect.value) {
      for (const opt of Array.from(originSelect.options)) {
        if (!opt.value) continue;
        const code = normalizeStr(opt.dataset.code || '');
        if (code && new RegExp(`(^|[_\\-\\s])${code}([_\\-\\s]|$)`).test(norm)) {
          originSelect.value = opt.value;
          suggestedAny = true;
          break;
        }
      }
    }

    const yearMatch = base.match(/(?:^|[_\-\s])(19\d{2}|20[0-3]\d)(?:$|[_\-\s])/);
    const detectedYear = yearMatch ? yearMatch[1] : null;
    if (detectedYear) {
      yearInput.value = detectedYear;
      suggestedAny = true;
    }

    if (!numberInput.value.trim()) {
      const tokens = base.split(/[_\-\s]+/);
      for (const tok of tokens) {
        if (tok === detectedYear) continue;
        if (/^\d{1,6}(-[A-Za-z0-9]+)?$/.test(tok)) {
          numberInput.value = tok.toUpperCase();
          suggestedAny = true;
          break;
        }
      }
    }

    // Detectar Número de Expediente si el nombre incluye formato XXX-XXXXXX-YYYY
    const expteMatch = base.match(/(?:(?:expte|expediente)[_\-\s]*)?([0-9]{2,4}-[0-9]{4,8}-(?:19\d{2}|20\d{2}))/i);
    if (expteMatch && !expedienteInput.value.trim()) {
      expedienteInput.value = expteMatch[1];
      suggestedAny = true;
    }

    if (suggestedAny) {
      autofillBanner.style.display = 'flex';
      checkLiveDuplicate();
    }
  }

  // Aplica el análisis profundo devuelto por el servidor al leer el contenido interno del PDF
  function applyBackendPdfAnalysis(analysis: any) {
    if (!analysis) return;

    let filledFields = 0;

    if (analysis.typeId && !typeSelect.value) {
      typeSelect.value = String(analysis.typeId);
      filledFields++;
    }
    if (analysis.originId && !originSelect.value) {
      originSelect.value = String(analysis.originId);
      filledFields++;
    }
    if (analysis.number && !numberInput.value.trim()) {
      numberInput.value = analysis.number;
      filledFields++;
    }
    if (analysis.year) {
      yearInput.value = String(analysis.year);
      filledFields++;
    }
    if (analysis.expediente && !expedienteInput.value.trim()) {
      expedienteInput.value = analysis.expediente;
      filledFields++;
    }
    if (analysis.caratula && !caratulaInput.value.trim()) {
      caratulaInput.value = analysis.caratula;
      filledFields++;
    }
    if (analysis.extracto && !extractoInput.value.trim()) {
      extractoInput.value = analysis.extracto;
      filledFields++;
    }
    if (analysis.rawText && !contenidoInput.value.trim()) {
      contenidoInput.value = analysis.rawText;
      filledFields++;
    }

    const meta = analysis.metadata || {};
    const dnis: string[] = meta.dnis || [];
    const cuils: string[] = meta.cuils || [];
    const people: string[] = meta.people || [];
    const institutions: string[] = meta.institutions || [];
    const detectedDate: string | null = meta.detectedDate || null;

    if (dnis.length > 0) {
      detectedDnisInput.value = dnis.join(', ');
    }
    if (cuils.length > 0 || detectedDate) {
      detectedCuilsInput.value = [...cuils, detectedDate ? `Fecha: ${detectedDate}` : ''].filter(Boolean).join(' | ');
    }
    if (people.length > 0) {
      detectedPeopleInput.value = people.join('; ');
    }
    if (institutions.length > 0) {
      detectedInstitutionsInput.value = institutions.join('; ');
    }
    if (detectedDate) {
      detectedDateInput.value = detectedDate;
    }

    const totalEntities = dnis.length + people.length + institutions.length;
    if (totalEntities > 0 || filledFields > 0) {
      autofillBanner.style.display = 'flex';
      autofillBannerText.textContent = `Lectura inteligente del PDF completada: ${dnis.length} DNI(s), ${people.length} persona(s) asociada(s) y metadatos autocompletados.`;
      detectedBadgeStatus.className = 'badge badge-completed';
      detectedBadgeStatus.innerHTML = `<span class="badge-dot"></span> ${totalEntities} dato(s) extraído(s)`;
    } else {
      detectedBadgeStatus.className = 'badge badge-neutral';
      detectedBadgeStatus.textContent = 'PDF analizado';
    }

    checkLiveDuplicate();
  }

  function handleFileSelected(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf')) {
      alert('Solo se admiten documentos en formato PDF.');
      return;
    }

    if (file.size > 50 * 1024 * 1024) {
      alert('El archivo supera el límite de 50 MB.');
      return;
    }

    dropzone.style.display = 'none';
    fileStatus.style.display = 'flex';
    fileNameDisplay.textContent = file.name;
    fileSizeDisplay.textContent = formatBytes(file.size);
    progressBarFill.style.width = '0%';
    progressPercent.textContent = 'Analizando PDF... 0%';

    // Mostrar previsualización local inmediata del PDF
    if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
    previewObjectUrl = URL.createObjectURL(file);
    localPdfPreview.src = previewObjectUrl;

    // Autocompletar preliminar por nombre de archivo
    smartAutofillFromFilename(file.name);

    // Subida con XMLHttpRequest para guardar en PostgreSQL y analizar entidades del PDF
    const xhr = new XMLHttpRequest();
    const formData = new FormData();
    formData.append('file', file);

    xhr.upload.addEventListener('progress', (e) => {
      if (e.lengthComputable) {
        const percent = Math.round((e.loaded / e.total) * 100);
        progressBarFill.style.width = percent + '%';
        progressPercent.textContent = `Subiendo y extrayendo datos... ${percent}%`;
      }
    });

    xhr.addEventListener('load', () => {
      if (xhr.status >= 200 && xhr.status < 300) {
        uploadedFileData = JSON.parse(xhr.responseText);
        progressBarFill.style.backgroundColor = '#10B981';
        progressPercent.textContent = '✓ PDF guardado en BD y datos extraídos automáticamente';
        if (uploadedFileData.analysis) {
          applyBackendPdfAnalysis(uploadedFileData.analysis);
        }
      } else {
        alert('Error al subir el archivo: ' + xhr.responseText);
        resetFile();
      }
    });

    xhr.addEventListener('error', () => {
      alert('Error de red al subir el archivo.');
      resetFile();
    });

    xhr.open('POST', '/api/upload/file');
    xhr.send(formData);
  }

  function resetFile() {
    uploadedFileData = null;
    fileInput.value = '';
    if (previewObjectUrl) {
      URL.revokeObjectURL(previewObjectUrl);
      previewObjectUrl = null;
    }
    localPdfPreview.src = 'about:blank';
    dropzone.style.display = 'block';
    fileStatus.style.display = 'none';
    progressBarFill.style.backgroundColor = 'var(--sj-red)';
  }

  removeFileBtn.addEventListener('click', resetFile);

  async function checkLiveDuplicate() {
    const typeId = typeSelect.value;
    const originId = originSelect.value;
    const number = numberInput.value.trim();
    const year = yearInput.value.trim();

    if (!typeId || !number || !year) {
      duplicateWarning.style.display = 'none';
      return;
    }

    try {
      const params = new URLSearchParams({ typeId, number, year });
      if (originId) params.append('originId', originId);

      const res = await fetch(`/api/documents/check-duplicate?${params.toString()}`);
      const data = await res.json();

      if (data.isDuplicate) {
        duplicateWarning.style.display = 'flex';
      } else {
        duplicateWarning.style.display = 'none';
      }
    } catch (err) {
      console.warn('Error verificando duplicado:', err);
    }
  }

  [typeSelect, originSelect, numberInput, yearInput].forEach((el) => {
    el.addEventListener('change', checkLiveDuplicate);
    el.addEventListener('blur', checkLiveDuplicate);
  });

  // Envío del Formulario
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.style.display = 'none';
    btnSave.disabled = true;

    const dnisList = detectedDnisInput.value
      .split(/[,;]+/)
      .map((s) => s.trim())
      .filter(Boolean);

    const cuilsList = detectedCuilsInput.value
      .split(/[|,;]+/)
      .map((s) => s.trim())
      .filter((s) => s && !s.toLowerCase().startsWith('fecha:'));

    const peopleList = detectedPeopleInput.value
      .split(/[;]+/)
      .map((s) => s.trim())
      .filter(Boolean);

    const institutionsList = detectedInstitutionsInput.value
      .split(/[;]+/)
      .map((s) => s.trim())
      .filter(Boolean);

    const extractedMetadata = {
      expediente: expedienteInput.value.trim() || null,
      dnis: dnisList,
      cuils: cuilsList,
      people: peopleList,
      institutions: institutionsList,
      detectedDate: detectedDateInput.value || null,
    };

    const payload = {
      typeId: typeSelect.value,
      originId: originSelect.value || null,
      number: numberInput.value.trim() || null,
      year: yearInput.value ? Number(yearInput.value) : null,
      expediente: expedienteInput.value.trim() || null,
      caratula: caratulaInput.value.trim() || null,
      extracto: extractoInput.value.trim() || null,
      contenido: contenidoInput.value.trim() || null,
      fileKey: uploadedFileData?.fileKey || null,
      fileName: uploadedFileData?.fileName || null,
      fileSize: uploadedFileData?.fileSize || null,
      fileSha256: uploadedFileData?.fileSha256 || null,
      pageCount: uploadedFileData?.analysis?.pageCount || 1,
      extractedMetadata,
    };

    try {
      const res = await fetch('/api/documents', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        window.location.href = `/documentos/${data.document.id}`;
      } else {
        formError.textContent = data.error || 'Error al guardar el documento';
        formError.style.display = 'block';
        btnSave.disabled = false;
      }
    } catch (err) {
      formError.textContent = 'Error de conexión con el servidor.';
      formError.style.display = 'block';
      btnSave.disabled = false;
    }
  });
</script>

