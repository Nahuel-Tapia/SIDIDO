---
import AppLayout from '../../layouts/AppLayout.astro';
import { searchDocuments } from '../../server/services/search';
import { getDocumentTypes, getOrigins } from '../../server/services/catalog';
import { canCreateOrEdit } from '../../server/auth/permissions';

const user = Astro.locals.user!;
const role = user.role;

// Extraer parámetros de búsqueda de la URL
const url = Astro.url;
const q = url.searchParams.get('q') || '';
const typeId = url.searchParams.get('typeId') ? Number(url.searchParams.get('typeId')) : undefined;
const originId = url.searchParams.get('originId') ? Number(url.searchParams.get('originId')) : undefined;
const number = url.searchParams.get('number') || '';
const year = url.searchParams.get('year') ? Number(url.searchParams.get('year')) : undefined;
const expediente = url.searchParams.get('expediente') || '';
const dni = url.searchParams.get('dni') || '';
const persona = url.searchParams.get('persona') || '';
const caratula = url.searchParams.get('caratula') || '';
const extracto = url.searchParams.get('extracto') || '';
const contenido = url.searchParams.get('contenido') || '';
const orderBy = (url.searchParams.get('orderBy') as any) || (q ? 'relevance' : 'date_desc');
const page = url.searchParams.get('page') ? Number(url.searchParams.get('page')) : 1;

// Cargar catálogos para los selectores
const types = await getDocumentTypes(true);
const originsList = await getOrigins(true);

// Ejecutar búsqueda (sin restricciones: busca con 0, 1 o cualquier combinación de filtros)
const searchResult = await searchDocuments({
  q,
  typeId,
  originId,
  number,
  year,
  expediente,
  dni,
  persona,
  caratula,
  extracto,
  contenido,
  orderBy,
  page,
  pageSize: 12,
});

const advancedFiltersCount = [
  originId,
  number,
  year,
  expediente,
  dni,
  persona,
  caratula,
  extracto,
  contenido,
].filter(Boolean).length;

const activeFiltersCount = [
  typeId,
  originId,
  number,
  year,
  expediente,
  dni,
  persona,
  caratula,
  extracto,
  contenido,
].filter(Boolean).length;

// Helper para construir URLs de filtro rápido conservando otros parámetros
function buildFilterUrl(overrides: Record<string, string | number | undefined>) {
  const params = new URLSearchParams(url.searchParams);
  params.delete('page');
  for (const [key, val] of Object.entries(overrides)) {
    if (val === undefined || val === '') {
      params.delete(key);
    } else {
      params.set(key, String(val));
    }
  }
  const qs = params.toString();
  return qs ? `/consultas?${qs}` : '/consultas';
}

const selectedOrigin = originsList.find((o) => o.id === originId);
---

<AppLayout title="Consultas de Documentos" activeNav="consultas">
  <div class="search-page">
    <!-- Encabezado de la Sección -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Consulta de Expedientes y Documentos</h1>
        <p class="page-desc">
          Busque por DNI, nombre asociado, número, año, escuela o cualquier palabra detectada en el PDF.
        </p>
      </div>

      {canCreateOrEdit(role) && (
        <a href="/anexar" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Anexar Documento</span>
        </a>
      )}
    </div>

    <!-- Tarjeta Principal de Búsqueda y Filtros Rápidos -->
    <form id="search-form" method="GET" class="search-box-card card">
      {typeId && <input type="hidden" name="typeId" id="hidden-type-id" value={typeId} />}

      <div class="main-search-row">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="main-q-input"
            name="q"
            value={q}
            class="main-search-input"
            placeholder="Buscar por DNI, nombre de docente/agente, resolución, escuela o contenido... (Presione /)"
            autocomplete="off"
          />
          {q ? (
            <a href={buildFilterUrl({ q: undefined })} class="clear-search-btn" title="Limpiar texto buscado">
              &times;
            </a>
          ) : (
            <span class="kbd-shortcut search-kbd" title="Atajo de teclado">/</span>
          )}
        </div>

        <button type="submit" class="btn btn-primary btn-search">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Buscar</span>
        </button>

        <button
          type="button"
          id="toggle-filters-btn"
          class={`btn btn-secondary ${advancedFiltersCount > 0 ? 'has-active' : ''}`}
          title="Abrir filtros específicos por DNI, Persona, Número o Año"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          <span>Más Filtros</span>
          {advancedFiltersCount > 0 && <span class="badge badge-active-count">{advancedFiltersCount}</span>}
        </button>
      </div>

      <!-- Barra de Píldoras de 1 Clic (Tipos de Documento + Orden Rápido) -->
      <div class="quick-pills-bar">
        <div class="chip-group" role="group" aria-label="Filtrar rápidamente por tipo de documento">
          <span class="quick-filter-label">Tipo:</span>
          <a
            href={buildFilterUrl({ typeId: undefined })}
            class={`chip ${!typeId ? 'active' : ''}`}
          >
            Todos
          </a>
          {types.map((t) => (
            <a
              href={buildFilterUrl({ typeId: typeId === t.id ? undefined : t.id })}
              class={`chip ${typeId === t.id ? 'active' : ''}`}
            >
              <span>{t.name}</span>
            </a>
          ))}
        </div>

        <!-- Selector rápido de ordenamiento -->
        <div class="quick-sort-box">
          <label for="quick-order" class="quick-filter-label">Orden:</label>
          <select
            id="quick-order"
            name="orderBy"
            class="quick-sort-select"
            onchange="this.form.submit()"
          >
            <option value="date_desc" selected={orderBy === 'date_desc'}>Más recientes</option>
            <option value="relevance" selected={orderBy === 'relevance'}>Mayor relevancia</option>
            <option value="year_desc" selected={orderBy === 'year_desc'}>Año (descendente)</option>
            <option value="number_asc" selected={orderBy === 'number_asc'}>Número (A-Z)</option>
            <option value="date_asc" selected={orderBy === 'date_asc'}>Más antiguos</option>
          </select>
        </div>
      </div>

      <!-- Chips de Filtros Avanzados Activos (Removibles con 1 clic) -->
      {(selectedOrigin || number || year || expediente || dni || persona || caratula || extracto || contenido) && (
        <div class="active-filters-strip">
          <span class="quick-filter-label">Filtros aplicados:</span>
          {expediente && (
            <a href={buildFilterUrl({ expediente: undefined })} class="chip chip-active-filter" title="Quitar filtro de expediente">
              Expte: {expediente} &times;
            </a>
          )}
          {dni && (
            <a href={buildFilterUrl({ dni: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              DNI: {dni} &times;
            </a>
          )}
          {persona && (
            <a href={buildFilterUrl({ persona: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              Persona: "{persona}" &times;
            </a>
          )}
          {selectedOrigin && (
            <a href={buildFilterUrl({ originId: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              Origen: {selectedOrigin.code} &times;
            </a>
          )}
          {number && (
            <a href={buildFilterUrl({ number: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              N°: {number} &times;
            </a>
          )}
          {year && (
            <a href={buildFilterUrl({ year: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              Año: {year} &times;
            </a>
          )}
          {caratula && (
            <a href={buildFilterUrl({ caratula: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              Carátula: "{caratula}" &times;
            </a>
          )}
          {extracto && (
            <a href={buildFilterUrl({ extracto: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              Extracto: "{extracto}" &times;
            </a>
          )}
          {contenido && (
            <a href={buildFilterUrl({ contenido: undefined })} class="chip chip-active-filter" title="Quitar filtro">
              Contenido OCR: "{contenido}" &times;
            </a>
          )}
          <a href="/consultas" class="clear-all-link">Limpiar todo</a>
        </div>
      )}

      <!-- Panel Desplegable de Filtros Específicos -->
      <div id="filters-panel" class="filters-panel" style={advancedFiltersCount > 0 ? 'display: block;' : 'display: none;'}>
        <div class="filters-grid">
          <!-- DNI / CUIL -->
          <div class="form-group">
            <label class="form-label" for="filter-dni">DNI / CUIL Detectado</label>
            <input
              type="text"
              id="filter-dni"
              name="dni"
              value={dni}
              placeholder="Ej: 28.456.789 o 28456789"
              class="form-input"
            />
          </div>

          <!-- Persona / Nombre Asociado -->
          <div class="form-group">
            <label class="form-label" for="filter-persona">Nombre Asociado (Agente/Docente)</label>
            <input
              type="text"
              id="filter-persona"
              name="persona"
              value={persona}
              placeholder="Ej: Quiroga, Sarmiento..."
              class="form-input"
            />
          </div>

          <!-- Origen -->
          <div class="form-group">
            <label class="form-label" for="filter-origin">Origen / Repartición</label>
            <select id="filter-origin" name="originId" class="form-select">
              <option value="">Todos los orígenes</option>
              {originsList.map((o) => (
                <option value={o.id} selected={originId === o.id}>
                  {o.name} ({o.code})
                </option>
              ))}
            </select>
          </div>

          <!-- Expediente -->
          <div class="form-group">
            <label class="form-label" for="filter-expediente">N° de Expediente</label>
            <input
              type="text"
              id="filter-expediente"
              name="expediente"
              value={expediente}
              placeholder="Ej: 300-028554-2026"
              class="form-input"
            />
          </div>

          <!-- Número -->
          <div class="form-group">
            <label class="form-label" for="filter-number">Número de Documento</label>
            <input
              type="text"
              id="filter-number"
              name="number"
              value={number}
              placeholder="Ej: 1420 o 4820-A"
              class="form-input"
            />
          </div>

          <!-- Año -->
          <div class="form-group">
            <label class="form-label" for="filter-year">Año</label>
            <input
              type="number"
              id="filter-year"
              name="year"
              value={year || ''}
              placeholder="Ej: 2024"
              min="1900"
              max="2030"
              class="form-input"
            />
          </div>

          <!-- Carátula -->
          <div class="form-group">
            <label class="form-label" for="filter-caratula">Texto en Carátula</label>
            <input
              type="text"
              id="filter-caratula"
              name="caratula"
              value={caratula}
              placeholder="Palabras en el título..."
              class="form-input"
            />
          </div>

          <!-- Extracto -->
          <div class="form-group">
            <label class="form-label" for="filter-extracto">Texto en Extracto</label>
            <input
              type="text"
              id="filter-extracto"
              name="extracto"
              value={extracto}
              placeholder="Palabras en el resumen..."
              class="form-input"
            />
          </div>

          <!-- Contenido Escaneado / OCR -->
          <div class="form-group">
            <label class="form-label" for="filter-contenido">Texto Interno (OCR)</label>
            <input
              type="text"
              id="filter-contenido"
              name="contenido"
              value={contenido}
              placeholder="Palabras dentro del PDF..."
              class="form-input"
            />
          </div>
        </div>

        <div class="filters-actions">
          <a href="/consultas" class="btn btn-secondary btn-sm">Restablecer Todo</a>
          <button type="submit" class="btn btn-dark btn-sm">Aplicar Filtros</button>
        </div>
      </div>
    </form>

    <!-- Resumen de Resultados -->
    <div class="results-meta">
      <span class="results-count">
        Mostrando <strong>{searchResult.items.length}</strong> de <strong>{searchResult.total}</strong> documentos encontrados
        {q && <span> para <strong>"{q}"</strong></span>}
      </span>
      <span class="results-page-indicator">
        Página {searchResult.page} de {searchResult.totalPages || 1}
      </span>
    </div>

    <!-- Grilla / Tabla de Resultados -->
    {searchResult.items.length === 0 ? (
      <div class="card empty-state">
        <div class="empty-icon-circle">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3 class="empty-title">No encontramos documentos con esos criterios</h3>
        <p class="empty-desc">
          Pruebe con términos más generales o quite alguno de los filtros activos. Recuerde que la búsqueda ignora tildes y mayúsculas automáticamente.
        </p>
        <a href="/consultas" class="btn btn-secondary" style="margin-top: 1rem;">Ver todos los documentos</a>
      </div>
    ) : (
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 150px;">N° / Año</th>
              <th style="width: 155px;">Clasificación</th>
              <th>Carátula y Síntesis</th>
              <th style="width: 125px;">Estado OCR</th>
              <th style="width: 210px; text-align: right;">Acciones Rápidas</th>
            </tr>
          </thead>
          <tbody>
            {searchResult.items.map((row: any) => (
              <tr class="doc-row">
                <td>
                  <a href={`/documentos/${row.id}`} class="doc-number-pill" title="Abrir ficha completa">
                    <strong>{row.number || 'S/N'}</strong>
                    <span class="doc-year">/{row.year || '----'}</span>
                  </a>
                  {row.expediente && (
                    <div style="margin-top: 4px;">
                      <a
                        href={buildFilterUrl({ expediente: row.expediente })}
                        class="badge"
                        style="font-size: 0.72rem; font-family: var(--font-mono); font-weight: 600; color: #1D252D; background: #FFF4E5; border: 1px solid #FFD8A8; text-decoration: none; display: inline-block; padding: 2px 6px;"
                        title={`Filtrar por Expediente ${row.expediente}`}
                      >
                        Exp: {row.expediente}
                      </a>
                    </div>
                  )}
                </td>
                <td>
                  <div class="type-origin-cell">
                    <span class="badge badge-neutral">{row.type_name}</span>
                    {row.origin_code && (
                      <span class="origin-sub" title={row.origin_name || row.origin_code}>
                        {row.origin_code}
                      </span>
                    )}
                  </div>
                </td>
                <td>
                  <div class="doc-content-cell">
                    <a href={`/documentos/${row.id}`} class="doc-title-link">
                      {row.caratula || 'Sin carátula especificada'}
                    </a>
                    {row.headline && (
                      <p class="doc-snippet" set:html={row.headline}></p>
                    )}
                    {row.extracted_metadata && (
                      (row.extracted_metadata.dnis?.length > 0 || row.extracted_metadata.people?.length > 0) && (
                        <div class="entity-badges-row">
                          {(row.extracted_metadata.dnis || []).slice(0, 3).map((d: string) => (
                            <a
                              href={buildFilterUrl({ dni: d })}
                              class="entity-pill entity-pill-dni"
                              title={`Filtrar todos los documentos con DNI ${d}`}
                            >
                              DNI {d}
                            </a>
                          ))}
                          {(row.extracted_metadata.people || []).slice(0, 3).map((p: string) => (
                            <a
                              href={buildFilterUrl({ persona: p })}
                              class="entity-pill entity-pill-person"
                              title={`Filtrar todos los documentos asociados a ${p}`}
                            >
                              {p}
                            </a>
                          ))}
                        </div>
                      )
                    )}
                  </div>
                </td>
                <td>
                  {row.ocr_status === 'completed' && (
                    <span class="badge badge-completed">
                      <span class="badge-dot"></span>
                      Indexado
                    </span>
                  )}
                  {row.ocr_status === 'processing' && (
                    <span class="badge badge-pending">
                      <span class="badge-dot"></span>
                      Procesando
                    </span>
                  )}
                  {row.ocr_status === 'pending' && (
                    <span class="badge badge-pending">
                      <span class="badge-dot"></span>
                      En cola
                    </span>
                  )}
                  {row.ocr_status === 'failed' && (
                    <span class="badge badge-failed">
                      <span class="badge-dot"></span>
                      Falló
                    </span>
                  )}
                  {row.ocr_status === 'none' && (
                    <span class="badge badge-neutral">Sin PDF</span>
                  )}
                </td>
                <td style="text-align: right;">
                  <div class="actions-cell">
                    <button
                      type="button"
                      class="btn btn-secondary btn-sm js-quick-preview"
                      data-id={row.id}
                      data-number={row.number || 'S/N'}
                      data-year={row.year || '----'}
                      data-type={row.type_name}
                      data-origin={row.origin_code || ''}
                      data-caratula={row.caratula || 'Sin carátula'}
                      data-extracto={row.extracto || ''}
                      data-expediente={row.expediente || ''}
                      data-has-file={row.file_key ? '1' : '0'}
                      title="Vista rápida del PDF sin salir del listado"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                      <span>Vista Rápida</span>
                    </button>

                    <a
                      href={`/documentos/${row.id}`}
                      class="btn btn-secondary btn-sm"
                      title="Abrir ficha completa y texto OCR"
                    >
                      Ficha
                    </a>

                    {row.file_key && (
                      <a
                        href={`/api/documents/${row.id}/file?download=1`}
                        class="btn btn-secondary btn-sm btn-icon"
                        title="Descargar PDF directamente"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Paginación -->
    {searchResult.totalPages > 1 && (
      <div class="pagination-wrapper">
        <div class="pagination">
          {page > 1 ? (
            <a
              href={buildFilterUrl({ page: page - 1 })}
              class="btn btn-secondary btn-sm"
            >
              &larr; Anterior
            </a>
          ) : (
            <button class="btn btn-secondary btn-sm" disabled>&larr; Anterior</button>
          )}

          <span class="pagination-info">
            Página <strong>{page}</strong> de <strong>{searchResult.totalPages}</strong>
          </span>

          {page < searchResult.totalPages ? (
            <a
              href={buildFilterUrl({ page: page + 1 })}
              class="btn btn-secondary btn-sm"
            >
              Siguiente &rarr;
            </a>
          ) : (
            <button class="btn btn-secondary btn-sm" disabled>Siguiente &rarr;</button>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Drawer Lateral de Vista Rápida (Sin salir del listado) -->
  <div id="preview-drawer-backdrop" class="drawer-backdrop" style="display: none;" aria-hidden="true">
    <aside class="preview-drawer" role="dialog" aria-labelledby="drawer-doc-title">
      <div class="drawer-header">
        <div class="drawer-meta-top">
          <div class="drawer-badges">
            <span id="drawer-type-badge" class="badge badge-neutral">Resolución</span>
            <span id="drawer-origin-badge" class="badge badge-neutral">ME</span>
            <span id="drawer-num-pill" class="doc-number-pill"><strong>1420</strong>/2024</span>
            <span id="drawer-exp-badge" class="badge" style="display: none; background: #FFF4E5; color: #1D252D; border: 1px solid #FFD8A8; font-weight: 600; font-family: var(--font-mono);"></span>
          </div>
          <h2 id="drawer-doc-title" class="drawer-title">Título del Documento</h2>
        </div>
        <button type="button" id="close-drawer-btn" class="drawer-close-btn" title="Cerrar vista rápida (Esc)">
          &times;
        </button>
      </div>

      <div id="drawer-extracto-box" class="drawer-extracto">
        <p id="drawer-extracto-text"></p>
      </div>

      <div class="drawer-pdf-container">
        <iframe id="drawer-pdf-iframe" class="drawer-pdf-frame" title="Vista previa del PDF"></iframe>
        <div id="drawer-no-pdf" class="drawer-empty-pdf" style="display: none;">
          <p>Este registro no posee archivo PDF escaneado adjunto.</p>
        </div>
      </div>

      <div class="drawer-footer">
        <a id="drawer-full-link" href="#" class="btn btn-dark">
          Abrir Ficha Completa y Texto OCR &rarr;
        </a>
        <a id="drawer-download-link" href="#" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Descargar PDF</span>
        </a>
      </div>
    </aside>
  </div>
</AppLayout>

<script>
  const toggleBtn = document.getElementById('toggle-filters-btn');
  const filtersPanel = document.getElementById('filters-panel');
  const mainSearchInput = document.getElementById('main-q-input') as HTMLInputElement;

  if (toggleBtn && filtersPanel) {
    toggleBtn.addEventListener('click', () => {
      const isVisible = filtersPanel.style.display !== 'none';
      filtersPanel.style.display = isVisible ? 'none' : 'block';
    });
  }

  // Atajo "/" para enfocar rápidamente el buscador
  document.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      document.activeElement !== mainSearchInput &&
      !['INPUT', 'TEXTAREA', 'SELECT'].includes((document.activeElement as HTMLElement)?.tagName || '')
    ) {
      e.preventDefault();
      mainSearchInput?.focus();
      mainSearchInput?.select();
    }
  });

  // Lógica del Drawer de Vista Rápida
  const backdrop = document.getElementById('preview-drawer-backdrop') as HTMLElement;
  const closeDrawerBtn = document.getElementById('close-drawer-btn') as HTMLElement;
  const drawerTitle = document.getElementById('drawer-doc-title') as HTMLElement;
  const drawerType = document.getElementById('drawer-type-badge') as HTMLElement;
  const drawerOrigin = document.getElementById('drawer-origin-badge') as HTMLElement;
  const drawerNumPill = document.getElementById('drawer-num-pill') as HTMLElement;
  const drawerExpBadge = document.getElementById('drawer-exp-badge') as HTMLElement;
  const drawerExtractoBox = document.getElementById('drawer-extracto-box') as HTMLElement;
  const drawerExtractoText = document.getElementById('drawer-extracto-text') as HTMLElement;
  const drawerIframe = document.getElementById('drawer-pdf-iframe') as HTMLIFrameElement;
  const drawerNoPdf = document.getElementById('drawer-no-pdf') as HTMLElement;
  const drawerFullLink = document.getElementById('drawer-full-link') as HTMLAnchorElement;
  const drawerDownloadLink = document.getElementById('drawer-download-link') as HTMLAnchorElement;

  function openQuickPreview(btn: HTMLElement) {
    const id = btn.dataset.id || '';
    const num = btn.dataset.number || 'S/N';
    const year = btn.dataset.year || '----';
    const type = btn.dataset.type || 'Documento';
    const origin = btn.dataset.origin || '';
    const caratula = btn.dataset.caratula || 'Sin carátula';
    const extracto = btn.dataset.extracto || '';
    const exp = btn.dataset.expediente || '';
    const hasFile = btn.dataset.hasFile === '1';

    drawerTitle.textContent = caratula;
    drawerType.textContent = type;
    if (origin) {
      drawerOrigin.textContent = origin;
      drawerOrigin.style.display = 'inline-flex';
    } else {
      drawerOrigin.style.display = 'none';
    }
    drawerNumPill.innerHTML = `<strong>${num}</strong>/${year}`;

    if (exp) {
      drawerExpBadge.textContent = `Expte: ${exp}`;
      drawerExpBadge.style.display = 'inline-flex';
    } else {
      drawerExpBadge.style.display = 'none';
    }

    if (extracto) {
      drawerExtractoText.textContent = extracto;
      drawerExtractoBox.style.display = 'block';
    } else {
      drawerExtractoBox.style.display = 'none';
    }

    drawerFullLink.href = `/documentos/${id}`;

    if (hasFile) {
      drawerIframe.src = `/api/documents/${id}/file`;
      drawerIframe.style.display = 'block';
      drawerNoPdf.style.display = 'none';
      drawerDownloadLink.href = `/api/documents/${id}/file?download=1`;
      drawerDownloadLink.style.display = 'inline-flex';
    } else {
      drawerIframe.src = 'about:blank';
      drawerIframe.style.display = 'none';
      drawerNoPdf.style.display = 'flex';
      drawerDownloadLink.style.display = 'none';
    }

    backdrop.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeQuickPreview() {
    backdrop.style.display = 'none';
    drawerIframe.src = 'about:blank';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.js-quick-preview').forEach((btn) => {
    btn.addEventListener('click', () => openQuickPreview(btn as HTMLElement));
  });

  closeDrawerBtn?.addEventListener('click', closeQuickPreview);
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeQuickPreview();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && backdrop?.style.display === 'flex') {
      closeQuickPreview();
    }
  });
</script>

