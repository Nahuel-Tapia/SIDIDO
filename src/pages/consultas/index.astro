---
import AppLayout from '../../layouts/AppLayout.astro';
import { searchDocuments } from '../../server/services/search';
import { getDocumentTypes, getOrigins } from '../../server/services/catalog';
import { canCreateOrEdit } from '../../server/auth/permissions';

const user = Astro.locals.user!;
const role = user.role;

// Extraer parámetros de búsqueda de la URL
const url = Astro.url;
const q = url.searchParams.get('q') || '';
const typeId = url.searchParams.get('typeId') ? Number(url.searchParams.get('typeId')) : undefined;
const originId = url.searchParams.get('originId') ? Number(url.searchParams.get('originId')) : undefined;
const number = url.searchParams.get('number') || '';
const year = url.searchParams.get('year') ? Number(url.searchParams.get('year')) : undefined;
const caratula = url.searchParams.get('caratula') || '';
const extracto = url.searchParams.get('extracto') || '';
const contenido = url.searchParams.get('contenido') || '';
const orderBy = (url.searchParams.get('orderBy') as any) || (q ? 'relevance' : 'date_desc');
const page = url.searchParams.get('page') ? Number(url.searchParams.get('page')) : 1;

// Cargar catálogos para los selectores
const types = await getDocumentTypes(true);
const originsList = await getOrigins(true);

// Ejecutar búsqueda (sin restricciones: busca con 0, 1 o cualquier combinación de filtros)
const searchResult = await searchDocuments({
  q,
  typeId,
  originId,
  number,
  year,
  caratula,
  extracto,
  contenido,
  orderBy,
  page,
  pageSize: 12,
});

const activeFiltersCount = [
  typeId,
  originId,
  number,
  year,
  caratula,
  extracto,
  contenido,
].filter(Boolean).length;
---

<AppLayout title="Consultas de Documentos" activeNav="consultas">
  <div class="search-page">
    <!-- Encabezado de la Sección -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Consulta de Expedientes y Documentos</h1>
        <p class="page-desc">
          Búsqueda de texto completo en carátula, extracto y contenido escaneado (insensible a tildes y mayúsculas).
        </p>
      </div>

      {canCreateOrEdit(role) && (
        <a href="/anexar" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Anexar Nuevo</span>
        </a>
      )}
    </div>

    <!-- Barra de Búsqueda Principal Minimalista -->
    <form id="search-form" method="GET" class="search-box-card card">
      <div class="main-search-row">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            name="q"
            value={q}
            class="main-search-input"
            placeholder="Buscar por palabra clave, tema, persona o contenido completo... (ej: calendario, concurso, conectividad)"
            autocomplete="off"
          />
        </div>

        <button type="submit" class="btn btn-dark btn-search">
          <span>Buscar</span>
        </button>

        <button
          type="button"
          id="toggle-filters-btn"
          class={`btn btn-secondary ${activeFiltersCount > 0 ? 'has-active' : ''}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          <span>Filtros</span>
          {activeFiltersCount > 0 && <span class="badge badge-active-count">{activeFiltersCount}</span>}
        </button>
      </div>

      <!-- Panel Desplegable de Filtros Específicos -->
      <div id="filters-panel" class="filters-panel" style={activeFiltersCount > 0 ? 'display: block;' : 'display: none;'}>
        <div class="filters-grid">
          <!-- Tipo de Documento -->
          <div class="form-group">
            <label class="form-label" for="filter-type">Tipo de Documento</label>
            <select id="filter-type" name="typeId" class="form-select">
              <option value="">Todos los tipos</option>
              {types.map((t) => (
                <option value={t.id} selected={typeId === t.id}>
                  {t.name} ({t.code})
                </option>
              ))}
            </select>
          </div>

          <!-- Origen -->
          <div class="form-group">
            <label class="form-label" for="filter-origin">Origen</label>
            <select id="filter-origin" name="originId" class="form-select">
              <option value="">Todos los orígenes</option>
              {originsList.map((o) => (
                <option value={o.id} selected={originId === o.id}>
                  {o.name} ({o.code})
                </option>
              ))}
            </select>
          </div>

          <!-- Número -->
          <div class="form-group">
            <label class="form-label" for="filter-number">Número</label>
            <input
              type="text"
              id="filter-number"
              name="number"
              value={number}
              placeholder="Ej: 1420 o 4820-A"
              class="form-input"
            />
          </div>

          <!-- Año -->
          <div class="form-group">
            <label class="form-label" for="filter-year">Año</label>
            <input
              type="number"
              id="filter-year"
              name="year"
              value={year || ''}
              placeholder="Ej: 2024"
              min="1900"
              max="2030"
              class="form-input"
            />
          </div>

          <!-- Carátula -->
          <div class="form-group">
            <label class="form-label" for="filter-caratula">Carátula</label>
            <input
              type="text"
              id="filter-caratula"
              name="caratula"
              value={caratula}
              placeholder="Texto en carátula..."
              class="form-input"
            />
          </div>

          <!-- Extracto -->
          <div class="form-group">
            <label class="form-label" for="filter-extracto">Extracto</label>
            <input
              type="text"
              id="filter-extracto"
              name="extracto"
              value={extracto}
              placeholder="Texto en extracto..."
              class="form-input"
            />
          </div>

          <!-- Contenido Escaneado / OCR -->
          <div class="form-group">
            <label class="form-label" for="filter-contenido">Contenido del Documento</label>
            <input
              type="text"
              id="filter-contenido"
              name="contenido"
              value={contenido}
              placeholder="Texto indexado en el PDF..."
              class="form-input"
            />
          </div>

          <!-- Orden -->
          <div class="form-group">
            <label class="form-label" for="filter-order">Ordenar por</label>
            <select id="filter-order" name="orderBy" class="form-select">
              <option value="relevance" selected={orderBy === 'relevance'}>Mayor relevancia</option>
              <option value="date_desc" selected={orderBy === 'date_desc'}>Más recientes primero</option>
              <option value="date_asc" selected={orderBy === 'date_asc'}>Más antiguos primero</option>
              <option value="year_desc" selected={orderBy === 'year_desc'}>Año descendente</option>
              <option value="number_asc" selected={orderBy === 'number_asc'}>Número ascendente</option>
            </select>
          </div>
        </div>

        <div class="filters-actions">
          <a href="/consultas" class="btn btn-secondary btn-sm">Limpiar Filtros</a>
          <button type="submit" class="btn btn-dark btn-sm">Aplicar Filtros</button>
        </div>
      </div>
    </form>

    <!-- Resumen de Resultados -->
    <div class="results-meta">
      <span class="results-count">
        Se encontraron <strong>{searchResult.total}</strong> documentos
        {q && <span> para la búsqueda "<em>{q}</em>"</span>}
      </span>
      <span class="results-page-indicator">
        Página {searchResult.page} de {searchResult.totalPages || 1}
      </span>
    </div>

    <!-- Grilla / Tabla de Resultados -->
    {searchResult.items.length === 0 ? (
      <div class="card empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <h3 class="empty-title">No se encontraron documentos</h3>
        <p class="empty-desc">
          Intente ajustando o quitando términos de búsqueda o filtros. SIDIDO no impone un mínimo de filtros obligatorios.
        </p>
        <a href="/consultas" class="btn btn-secondary" style="margin-top: 1rem;">Ver todos los documentos</a>
      </div>
    ) : (
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 130px;">Documento</th>
              <th style="width: 140px;">Tipo / Origen</th>
              <th>Carátula y Extracto</th>
              <th style="width: 110px;">OCR</th>
              <th style="width: 160px; text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {searchResult.items.map((row: any) => (
              <tr>
                <td>
                  <a href={`/documentos/${row.id}`} class="doc-code-link">
                    <strong>{row.number || 'S/N'}</strong>
                    <span class="doc-year">/{row.year || '----'}</span>
                  </a>
                </td>
                <td>
                  <div class="type-origin-cell">
                    <span class="badge badge-neutral">{row.type_name}</span>
                    {row.origin_code && (
                      <span class="origin-sub">{row.origin_code}</span>
                    )}
                  </div>
                </td>
                <td>
                  <div class="doc-content-cell">
                    <a href={`/documentos/${row.id}`} class="doc-title-link">
                      {row.caratula || 'Sin carátula especificada'}
                    </a>
                    {row.headline && (
                      <p class="doc-snippet" set:html={row.headline}></p>
                    )}
                  </div>
                </td>
                <td>
                  {row.ocr_status === 'completed' && (
                    <span class="badge badge-completed">Indexado</span>
                  )}
                  {row.ocr_status === 'processing' && (
                    <span class="badge badge-pending">Procesando</span>
                  )}
                  {row.ocr_status === 'pending' && (
                    <span class="badge badge-pending">En cola</span>
                  )}
                  {row.ocr_status === 'failed' && (
                    <span class="badge badge-failed">Falló</span>
                  )}
                  {row.ocr_status === 'none' && (
                    <span class="badge badge-neutral">S/A</span>
                  )}
                </td>
                <td style="text-align: right;">
                  <div class="actions-cell">
                    <a
                      href={`/documentos/${row.id}`}
                      class="btn btn-secondary btn-sm"
                      title="Ver Ficha y PDF"
                    >
                      Ver
                    </a>
                    {row.file_key && (
                      <a
                        href={`/api/documents/${row.id}/file?download=1`}
                        class="btn btn-secondary btn-sm"
                        title="Descargar PDF"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                      </a>
                    )}
                    {canCreateOrEdit(role) && (
                      <a
                        href={`/documentos/${row.id}/editar`}
                        class="btn btn-secondary btn-sm"
                        title="Editar"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Paginación -->
    {searchResult.totalPages > 1 && (
      <div class="pagination-wrapper">
        <div class="pagination">
          {page > 1 ? (
            <a
              href={`/consultas?${new URLSearchParams({
                ...Object.fromEntries(url.searchParams),
                page: String(page - 1),
              }).toString()}`}
              class="btn btn-secondary btn-sm"
            >
              &larr; Anterior
            </a>
          ) : (
            <button class="btn btn-secondary btn-sm" disabled>&larr; Anterior</button>
          )}

          <span class="pagination-info">
            Página {page} de {searchResult.totalPages}
          </span>

          {page < searchResult.totalPages ? (
            <a
              href={`/consultas?${new URLSearchParams({
                ...Object.fromEntries(url.searchParams),
                page: String(page + 1),
              }).toString()}`}
              class="btn btn-secondary btn-sm"
            >
              Siguiente &rarr;
            </a>
          ) : (
            <button class="btn btn-secondary btn-sm" disabled>Siguiente &rarr;</button>
          )}
        </div>
      </div>
    )}
  </div>
</AppLayout>

<script>
  const toggleBtn = document.getElementById('toggle-filters-btn');
  const filtersPanel = document.getElementById('filters-panel');

  if (toggleBtn && filtersPanel) {
    toggleBtn.addEventListener('click', () => {
      const isVisible = filtersPanel.style.display !== 'none';
      filtersPanel.style.display = isVisible ? 'none' : 'block';
    });
  }
</script>

<style>
  .search-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sj-charcoal);
    letter-spacing: -0.01em;
  }

  .page-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .search-box-card {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .main-search-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-input-wrapper {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.875rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .main-search-input {
    width: 100%;
    padding: 0.625rem 1rem 0.625rem 2.625rem;
    font-size: 0.9375rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    color: var(--text-primary);
  }

  .main-search-input:focus {
    border-color: var(--sj-charcoal);
    outline: none;
    box-shadow: 0 0 0 1px var(--sj-charcoal);
  }

  .btn-search {
    padding: 0.625rem 1.25rem;
  }

  .has-active {
    border-color: var(--sj-red);
    color: var(--sj-red);
  }

  .badge-active-count {
    background-color: var(--sj-red);
    color: white;
    margin-left: 0.25rem;
  }

  .filters-panel {
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  .filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .filters-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .results-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0 0.25rem;
  }

  .doc-code-link {
    font-size: 0.9375rem;
    color: var(--sj-charcoal);
  }
  .doc-code-link:hover {
    color: var(--sj-red);
  }

  .doc-year {
    color: var(--text-muted);
  }

  .type-origin-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  .origin-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .doc-content-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .doc-title-link {
    font-weight: 600;
    color: var(--sj-charcoal);
  }
  .doc-title-link:hover {
    color: var(--sj-red);
  }

  .doc-snippet {
    font-size: 0.8125rem;
    color: #4B5563;
    line-height: 1.4;
  }

  .actions-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .empty-state {
    padding: 3.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .empty-icon {
    color: #9CA3AF;
    margin-bottom: 0.75rem;
  }

  .empty-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sj-charcoal);
  }

  .empty-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: 420px;
    margin-top: 0.25rem;
  }

  .pagination-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pagination-info {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .main-search-row {
      flex-wrap: wrap;
    }
    .search-input-wrapper {
      min-width: 100%;
    }
  }
</style>
