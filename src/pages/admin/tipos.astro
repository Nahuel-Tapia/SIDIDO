---
import AppLayout from '../../layouts/AppLayout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import { getDocumentTypes } from '../../server/services/catalog';
import { canAdmin } from '../../server/auth/permissions';

const user = Astro.locals.user!;
if (!canAdmin(user.role)) return Astro.redirect('/consultas');

const types = await getDocumentTypes(false);
---

<AppLayout title="Tipos de Documento" activeNav="admin">
  <div class="catalog-page">
    <AdminNav activeTab="tipos" />

    <div class="page-header">
      <div>
        <h1 class="page-title">Gestión de Tipos de Documento</h1>
        <p class="page-desc">ABM de clasificaciones documentales (ej: Resolución, Decreto, Expediente).</p>
      </div>

      <button type="button" id="open-create-btn" class="btn btn-primary">
        + Nuevo Tipo
      </button>
    </div>

    <!-- Modal / Formulario de Creación -->
    <div id="create-modal" class="modal-overlay" style="display: none;">
      <div class="modal-card card">
        <h2 class="modal-title">Crear Nuevo Tipo de Documento</h2>
        <form id="create-type-form" class="modal-form">
          <div class="form-group">
            <label for="type-code" class="form-label">Código (Sigla)</label>
            <input type="text" id="type-code" class="form-input" placeholder="Ej: RES, DEC, NOTA" required />
          </div>
          <div class="form-group">
            <label for="type-name" class="form-label">Nombre Completo</label>
            <input type="text" id="type-name" class="form-input" placeholder="Ej: Resolución Ministerial" required />
          </div>
          <div class="modal-actions">
            <button type="button" id="close-modal-btn" class="btn btn-secondary btn-sm">Cancelar</button>
            <button type="submit" class="btn btn-primary btn-sm">Guardar Tipo</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabla de Tipos -->
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th style="width: 110px;">Código</th>
            <th>Nombre del Tipo</th>
            <th style="width: 130px;">Estado</th>
            <th style="width: 180px; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {types.map((t) => (
            <tr>
              <td><span class="doc-number-pill"><strong>{t.code}</strong></span></td>
              <td><strong>{t.name}</strong></td>
              <td>
                {t.active ? (
                  <span class="badge badge-completed"><span class="badge-dot"></span>Activo</span>
                ) : (
                  <span class="badge badge-neutral">Inactivo</span>
                )}
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 0.4rem;">
                  <a href={`/consultas?typeId=${t.id}`} class="btn btn-secondary btn-sm">Ver Docs</a>
                  <button
                    type="button"
                    class="btn btn-secondary btn-sm toggle-btn"
                    data-id={t.id}
                    data-active={t.active ? 'false' : 'true'}
                  >
                    {t.active ? 'Desactivar' : 'Activar'}
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>

<script>
  const modal = document.getElementById('create-modal') as HTMLElement;
  const openBtn = document.getElementById('open-create-btn') as HTMLElement;
  const closeBtn = document.getElementById('close-modal-btn') as HTMLElement;
  const form = document.getElementById('create-type-form') as HTMLFormElement;

  openBtn.addEventListener('click', () => (modal.style.display = 'flex'));
  closeBtn.addEventListener('click', () => (modal.style.display = 'none'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (document.getElementById('type-code') as HTMLInputElement).value;
    const name = (document.getElementById('type-name') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/catalog/types', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, name }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || 'Error al guardar tipo');
      }
    } catch {
      alert('Error de conexión');
    }
  });

  document.querySelectorAll('.toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const active = btn.getAttribute('data-active') === 'true';

      try {
        const res = await fetch('/api/catalog/types', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, active }),
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch {
        alert('Error al actualizar');
      }
    });
  });
</script>

<style>
  .catalog-page {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .page-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--sj-charcoal);
  }
  .page-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(29, 37, 45, 0.45);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 1rem;
  }
  .modal-card {
    width: 100%;
    max-width: 440px;
  }
  .modal-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
</style>
