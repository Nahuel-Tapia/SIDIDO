---
import AppLayout from '../../layouts/AppLayout.astro';
import { getOrigins } from '../../server/services/catalog';
import { canAdmin } from '../../server/auth/permissions';

const user = Astro.locals.user!;
if (!canAdmin(user.role)) return Astro.redirect('/consultas');

const originsList = await getOrigins(false);
---

<AppLayout title="Orígenes y Reparticiones" activeNav="admin">
  <div class="catalog-page">
    <div class="page-header">
      <div>
        <a href="/admin" class="back-link">&larr; Volver al Panel</a>
        <h1 class="page-title">Gestión de Orígenes y Reparticiones</h1>
        <p class="page-desc">ABM de dependencias emisoras (ej: ME, DGEP, DGES, SAF).</p>
      </div>

      <button type="button" id="open-create-btn" class="btn btn-primary">
        + Nuevo Origen
      </button>
    </div>

    <!-- Modal de Creación -->
    <div id="create-modal" class="modal-overlay" style="display: none;">
      <div class="modal-card card">
        <h2 class="modal-title">Crear Nuevo Origen</h2>
        <form id="create-origin-form" class="modal-form">
          <div class="form-group">
            <label for="origin-code" class="form-label">Sigla / Código</label>
            <input type="text" id="origin-code" class="form-input" placeholder="Ej: ME, DGEP, SAF" required />
          </div>
          <div class="form-group">
            <label for="origin-name" class="form-label">Nombre Completo de la Repartición</label>
            <input type="text" id="origin-name" class="form-input" placeholder="Ej: Ministerio de Educación" required />
          </div>
          <div class="modal-actions">
            <button type="button" id="close-modal-btn" class="btn btn-secondary btn-sm">Cancelar</button>
            <button type="submit" class="btn btn-primary btn-sm">Guardar Origen</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabla de Orígenes -->
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th style="width: 120px;">Sigla</th>
            <th>Nombre de la Repartición</th>
            <th style="width: 120px;">Estado</th>
            <th style="width: 140px; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {originsList.map((o) => (
            <tr>
              <td><strong>{o.code}</strong></td>
              <td>{o.name}</td>
              <td>
                {o.active ? (
                  <span class="badge badge-completed">Activo</span>
                ) : (
                  <span class="badge badge-neutral">Inactivo</span>
                )}
              </td>
              <td style="text-align: right;">
                <button
                  type="button"
                  class="btn btn-secondary btn-sm toggle-btn"
                  data-id={o.id}
                  data-active={o.active ? 'false' : 'true'}
                >
                  {o.active ? 'Desactivar' : 'Activar'}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>

<script>
  const modal = document.getElementById('create-modal') as HTMLElement;
  const openBtn = document.getElementById('open-create-btn') as HTMLElement;
  const closeBtn = document.getElementById('close-modal-btn') as HTMLElement;
  const form = document.getElementById('create-origin-form') as HTMLFormElement;

  openBtn.addEventListener('click', () => (modal.style.display = 'flex'));
  closeBtn.addEventListener('click', () => (modal.style.display = 'none'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (document.getElementById('origin-code') as HTMLInputElement).value;
    const name = (document.getElementById('origin-name') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/catalog/origins', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, name }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || 'Error al guardar origen');
      }
    } catch {
      alert('Error de conexión');
    }
  });

  document.querySelectorAll('.toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const active = btn.getAttribute('data-active') === 'true';

      try {
        const res = await fetch('/api/catalog/origins', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, active }),
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch {
        alert('Error al actualizar');
      }
    });
  });
</script>

<style>
  .catalog-page { display: flex; flex-direction: column; gap: 1.5rem; }
  .page-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .back-link { font-size: 0.8125rem; color: var(--text-muted); }
  .page-title { font-size: 1.375rem; font-weight: 700; color: var(--sj-charcoal); }
  .page-desc { font-size: 0.875rem; color: var(--text-muted); }
  .modal-overlay { position: fixed; inset: 0; background-color: rgba(29, 37, 45, 0.4); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 1rem; }
  .modal-card { width: 100%; max-width: 440px; }
  .modal-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; }
  .modal-form { display: flex; flex-direction: column; gap: 1rem; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; }
</style>
