---
interface Props {
  variant?: 'horizontal' | 'vertical' | 'mark-only';
  size?: 'sm' | 'md' | 'lg';
  theme?: 'color' | 'mono';
}

const { variant = 'horizontal', size = 'md', theme = 'color' } = Astro.props;

const sizes = {
  sm: { icon: 30, fontTitle: '16px', fontSub: '13px' },
  md: { icon: 40, fontTitle: '20px', fontSub: '16px' },
  lg: { icon: 56, fontTitle: '26px', fontSub: '20px' }
};

const currentSize = sizes[size];
---

<div class={`logo-container logo-${variant} logo-${theme}`}>
  <svg
    width={currentSize.icon}
    height={currentSize.icon}
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Sol/Roseta Oficial San Juan Gobierno -->
    <g transform="translate(50,50)">
      <!-- Pétalos exteriores amarillos (Pantone 114 C #FBDD40) -->
      <circle cx="0" cy="-28" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="20" cy="-20" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="28" cy="0" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="20" cy="20" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="0" cy="28" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="-20" cy="20" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="-28" cy="0" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
      <circle cx="-20" cy="-20" r="16" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />

      <!-- Pétalos intermedios naranjas (Pantone 151 C #FF8200) -->
      <circle cx="0" cy="-18" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="13" cy="-13" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="18" cy="0" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="13" cy="13" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="0" cy="18" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="-13" cy="13" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="-18" cy="0" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />
      <circle cx="-13" cy="-13" r="13" fill={theme === 'mono' ? '#1D252D' : '#FF8200'} />

      <!-- Núcleo central rojo cálido (Pantone 179 C #E03C31) -->
      <circle cx="0" cy="-9" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="6" cy="-6" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="9" cy="0" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="6" cy="6" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="0" cy="9" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="-6" cy="6" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="-9" cy="0" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="-6" cy="-6" r="9" fill={theme === 'mono' ? '#1D252D' : '#E03C31'} />
      <circle cx="0" cy="0" r="6" fill={theme === 'mono' ? '#1D252D' : '#FBDD40'} />
    </g>
  </svg>

  {variant !== 'mark-only' && (
    <div class="logo-text">
      <span class="logo-title" style={`font-size: ${currentSize.fontTitle}`}>San Juan</span>
      <span class="logo-subtitle" style={`font-size: ${currentSize.fontSub}`}>Gobierno</span>
    </div>
  )}
</div>

<style>
  .logo-container {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    user-select: none;
  }
  .logo-vertical {
    flex-direction: column;
    text-align: center;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo-title {
    font-weight: 700;
    color: var(--sj-charcoal);
    letter-spacing: -0.02em;
  }
  .logo-subtitle {
    font-weight: 400;
    color: var(--sj-charcoal);
    letter-spacing: -0.01em;
  }
</style>
