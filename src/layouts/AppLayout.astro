---
import '../styles/global.css';
import LogoSanJuan from '../components/brand/LogoSanJuan.astro';
import { canAdmin, canCreateOrEdit } from '../server/auth/permissions';

interface Props {
  title: string;
  activeNav?: 'consultas' | 'anexar' | 'admin';
}

const { title, activeNav = 'consultas' } = Astro.props;
const user = Astro.locals.user;
const role = user?.role || 'consulta';

const roleLabels: Record<string, { label: string; class: string }> = {
  admin: { label: 'Administrador', class: 'badge-failed' }, // Usamos color rojo suave para admin
  operador: { label: 'Operador', class: 'badge-pending' },   // Naranja suave para operador
  consulta: { label: 'Consulta', class: 'badge-neutral' },   // Gris neutro para consulta
};

const userBadge = roleLabels[role] || roleLabels.consulta;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SIDIDO | San Juan Gobierno</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="app-body">
    <!-- Navbar Oficial Superior -->
    <header class="app-header">
      <div class="header-inner">
        <!-- Logo y Sistema -->
        <div class="header-brand">
          <a href="/consultas" class="brand-link" title="Ir al inicio">
            <LogoSanJuan variant="horizontal" size="sm" theme="color" />
          </a>
          <div class="brand-separator"></div>
          <div class="system-badge">
            <span class="system-acronym">SIDIDO</span>
            <span class="system-dept">Educación</span>
          </div>
        </div>

        <!-- Navegación Principal -->
        <nav class="app-nav" aria-label="Navegación principal">
          <a
            href="/consultas"
            class={`nav-item ${activeNav === 'consultas' ? 'active' : ''}`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Consultas</span>
          </a>

          {canCreateOrEdit(role) && (
            <a
              href="/anexar"
              class={`nav-item ${activeNav === 'anexar' ? 'active' : ''}`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
              </svg>
              <span>Anexar Documento</span>
            </a>
          )}

          {canAdmin(role) && (
            <div class="nav-dropdown-container">
              <a
                href="/admin"
                class={`nav-item ${activeNav === 'admin' ? 'active' : ''}`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span>Administración</span>
              </a>
            </div>
          )}
        </nav>

        <!-- Área de Usuario y Logout -->
        <div class="header-user">
          <div class="user-meta">
            <span class="user-name">{user?.fullName || 'Usuario'}</span>
            <span class={`badge ${userBadge.class}`}>{userBadge.label}</span>
          </div>

          <a href="/logout" class="btn btn-secondary btn-sm btn-logout" title="Cerrar Sesión">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span class="logout-text">Salir</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="app-main">
      <slot />
    </main>

    <!-- Footer Institucional Discreto -->
    <footer class="app-footer">
      <div class="footer-inner">
        <span>Ministerio de Educación — Gobierno de San Juan</span>
        <span>SIDIDO 2.0 • Sistema Integral de Documentos Digitalizados</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .app-body {
    background-color: var(--bg-main);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .app-header {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-light);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
  }

  .brand-separator {
    width: 1px;
    height: 28px;
    background-color: var(--border-light);
  }

  .system-badge {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .system-acronym {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--sj-charcoal);
    letter-spacing: -0.01em;
  }

  .system-dept {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sj-red);
    text-transform: uppercase;
  }

  .app-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sj-charcoal);
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    background-color: var(--bg-alt);
    color: var(--sj-red);
  }

  .nav-item.active {
    background-color: var(--sj-red-subtle);
    color: var(--sj-red);
    font-weight: 600;
  }

  .header-user {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  .user-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sj-charcoal);
  }

  .btn-logout {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .app-main {
    flex: 1;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 1.75rem 1.5rem;
  }

  .app-footer {
    border-top: 1px solid var(--border-light);
    background-color: var(--bg-surface);
    padding: 1rem 1.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-wrap: wrap;
      padding: 0.75rem 1rem;
    }
    .brand-separator, .system-badge {
      display: none;
    }
    .logout-text {
      display: none;
    }
    .footer-inner {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
