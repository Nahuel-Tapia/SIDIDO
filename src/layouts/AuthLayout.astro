---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Acceso al Sistema - SIDIDO' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Ministerio de Educación de San Juan</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="auth-body">
    <main class="auth-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .auth-body {
    background-color: var(--bg-main);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 1.5rem;
  }
  .auth-main {
    width: 100%;
    max-width: 440px;
  }
</style>
